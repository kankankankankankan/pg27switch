<Window x:Class="PG27Switch.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="564"
        Height="364"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        KeyDown="OnKeyDown">
    <Grid>
        <Border x:Name="Shadow"
                Width="500"
                Height="300"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#01000000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34"
                                  ShadowDepth="0"
                                  Opacity="0.42"
                                  Color="#000000"/>
            </Border.Effect>
        </Border>

        <Border x:Name="Panel"
                Width="500"
                Height="300"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#191B1C"
                BorderBrush="#404244"
                BorderThickness="1">
            <Grid ClipToBounds="True">
                <Border x:Name="TopAccent"
                        Width="104"
                        Height="18"
                        CornerRadius="0,0,5,5"
                        Background="#9F2024"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"/>

                <Viewbox Width="34"
                         Height="34"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Margin="0,1,0,0">
                    <Canvas x:Name="IconCanvas" Width="24" Height="24"/>
                </Viewbox>

                <Canvas IsHitTestVisible="False">
                    <Polyline Points="24,30 38,30 46,22"
                              Stroke="#8C2529"
                              StrokeThickness="1.2"
                              Opacity="0.78"/>
                    <Polyline Points="454,248 474,248 484,238"
                              Stroke="#596064"
                              StrokeThickness="1.1"
                              Opacity="0.72"/>
                    <Rectangle Width="42"
                               Height="1"
                               Canvas.Left="406"
                               Canvas.Top="66"
                               Fill="#8F7E57"
                               Opacity="0.68"/>
                    <Rectangle Width="78"
                               Height="1"
                               Canvas.Left="52"
                               Canvas.Top="235"
                               Fill="#596064"
                               Opacity="0.56"/>
                </Canvas>

                <StackPanel Width="416"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,28,0,0">
                    <TextBlock x:Name="StatusText"
                               Text="切换屏幕输入源"
                               Foreground="#B6B9BA"
                               FontSize="18"
                               FontWeight="Normal"
                               TextAlignment="Center"/>
                    <TextBlock x:Name="TargetText"
                               Margin="0,26,0,0"
                               Foreground="#F2F2F0"
                               FontSize="35"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CountdownText"
                               Height="78"
                               Margin="0,10,0,0"
                               Foreground="#F2F2F0"
                               FontSize="72"
                               FontWeight="Bold"
                               FontFamily="Consolas"
                               TextAlignment="Center"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="78"/>
                    <TextBlock x:Name="HintText"
                               Text="ESC 取消"
                               Margin="0,7,0,0"
                               Foreground="#B6B9BA"
                               FontSize="16"
                               FontWeight="Medium"
                               TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
