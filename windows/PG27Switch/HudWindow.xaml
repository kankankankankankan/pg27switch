<Window x:Class="PG27Switch.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="564"
        Height="364"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        KeyDown="OnKeyDown">
    <Grid>
        <Border x:Name="Shadow"
                Width="500"
                Height="300"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#0F0F10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  Direction="270"
                                  ShadowDepth="8"
                                  Opacity="0.32"
                                  Color="#000000"/>
            </Border.Effect>
        </Border>

        <Border x:Name="Panel"
                Width="500"
                Height="300"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#191B1C"
                BorderBrush="#404244"
                BorderThickness="1">
            <Grid ClipToBounds="True">
                <Border x:Name="InnerHighlight"
                        Width="498"
                        Height="298"
                        CornerRadius="19"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderThickness="1"
                        Background="Transparent"
                        BorderBrush="#08FFFFFF"
                        IsHitTestVisible="False"/>

                <Border x:Name="HeaderFill"
                        Height="34"
                        VerticalAlignment="Top"
                        CornerRadius="20,20,0,0"
                        Background="#18EB141C"/>

                <Border x:Name="TopAccent"
                        Height="3"
                        VerticalAlignment="Top"
                        CornerRadius="20,20,0,0"
                        Background="#DB1219"/>

                <Rectangle x:Name="HeaderLine"
                           Height="1"
                           Width="316"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,34,0,0"
                           Fill="#13FFFFFF"/>

                <Viewbox Width="34"
                         Height="34"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Margin="0,1,0,0">
                         <Canvas x:Name="IconCanvas" Width="24" Height="24"/>
                </Viewbox>

                <Canvas IsHitTestVisible="False">
                    <Path x:Name="HeaderChevrons"
                          Fill="#80EB141C"
                          Data="M24,15 L32,15 L38,21 L32,21 Z M36,15 L44,15 L50,21 L44,21 Z M48,15 L56,15 L62,21 L56,21 Z"/>

                    <Path x:Name="MicroGrid"
                          Stroke="#08FFFFFF"
                          StrokeThickness="1"
                          Data="M26,62 L62,62 M26,71 L62,71 M26,80 L62,80 M26,88 L62,88 M26,62 L26,88 M35,62 L35,88 M44,62 L44,88 M53,62 L53,88 M62,62 L62,88"/>

                    <Path x:Name="GoldTicks"
                          Stroke="#7AD1A85C"
                          StrokeThickness="1"
                          Data="M422,18 L462,18 M438,278 L472,278"/>

                    <Path x:Name="SideRail"
                          Stroke="#28EB141C"
                          StrokeThickness="1"
                          Data="M476,108 L476,160 M458,108 L476,108 M458,160 L476,160"/>

                    <Path x:Name="CornerLines"
                          Stroke="#08FFFFFF"
                          StrokeThickness="2"
                          Data="M24,252 L24,280 L78,280 M476,252 L476,280 L422,280"/>
                </Canvas>

                <StackPanel Width="416"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,28,0,0">
                    <TextBlock x:Name="StatusText"
                               Text="切换屏幕输入源"
                               Foreground="#B6B9BA"
                               FontSize="18"
                               FontWeight="Normal"
                               TextAlignment="Center"/>
                    <TextBlock x:Name="TargetText"
                               Margin="0,26,0,0"
                               Foreground="#F2F2F0"
                               FontSize="35"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CountdownText"
                               Height="78"
                               Margin="0,10,0,0"
                               Foreground="#F2F2F0"
                               FontSize="72"
                               FontWeight="Bold"
                               FontFamily="Consolas"
                               TextAlignment="Center"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="78"/>
                    <TextBlock x:Name="HintText"
                               Text="ESC 取消"
                               Margin="0,7,0,0"
                               Foreground="#B6B9BA"
                               FontSize="16"
                               FontWeight="Medium"
                               TextAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="BottomStrip"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,11"
                            Height="12"
                            Opacity="0.48">
                    <TextBlock Text="0&gt;&gt;&gt;1"
                               FontFamily="Consolas"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#16FFFFFF"
                               Margin="0,0,8,0"/>
                    <Canvas Width="34" Height="10" Margin="0,0,8,0">
                        <Ellipse Width="2" Height="2" Canvas.Left="0" Canvas.Top="1" Fill="#16FFFFFF"/>
                        <Ellipse Width="2" Height="2" Canvas.Left="6" Canvas.Top="1" Fill="#16FFFFFF"/>
                        <Ellipse Width="2" Height="2" Canvas.Left="12" Canvas.Top="1" Fill="#16FFFFFF"/>
                        <Ellipse Width="2" Height="2" Canvas.Left="18" Canvas.Top="1" Fill="#16FFFFFF"/>
                        <Ellipse Width="2" Height="2" Canvas.Left="24" Canvas.Top="1" Fill="#16FFFFFF"/>
                        <Ellipse Width="2" Height="2" Canvas.Left="30" Canvas.Top="1" Fill="#16FFFFFF"/>
                        <Ellipse Width="2" Height="2" Canvas.Left="0" Canvas.Top="6" Fill="#16FFFFFF"/>
                        <Ellipse Width="2" Height="2" Canvas.Left="6" Canvas.Top="6" Fill="#16FFFFFF"/>
                        <Ellipse Width="2" Height="2" Canvas.Left="12" Canvas.Top="6" Fill="#16FFFFFF"/>
                        <Ellipse Width="2" Height="2" Canvas.Left="18" Canvas.Top="6" Fill="#16FFFFFF"/>
                        <Ellipse Width="2" Height="2" Canvas.Left="24" Canvas.Top="6" Fill="#16FFFFFF"/>
                        <Ellipse Width="2" Height="2" Canvas.Left="30" Canvas.Top="6" Fill="#16FFFFFF"/>
                    </Canvas>
                    <Canvas Width="24" Height="10" Margin="0,0,8,0">
                        <Path Stroke="#16FFFFFF" StrokeThickness="2" Data="M0,9 L8,1 M5,9 L13,1 M10,9 L18,1 M15,9 L23,1"/>
                    </Canvas>
                    <Canvas Width="32" Height="8">
                        <Path Stroke="#16FFFFFF" StrokeThickness="1" Data="M0,4 L2,4 M5,4 L7,4 M10,4 L12,4 M15,4 L17,4 M20,4 L22,4 M25,4 L27,4 M30,4 L32,4"/>
                    </Canvas>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
